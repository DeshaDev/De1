# Copy to .env locally. Never commit real credentials or keys.
# Generate each secret separately and configure production secrets in your hosting provider.
# Example: openssl rand -hex 32

GEMINI_API_KEY=
APP_URL=

# Required: at least 20 characters. This code grants clinician permissions.
CLINICAL_ACCESS_CODE=

# Optional: at least 20 characters. This code grants read-only educator access plus AI reader utilities.
EDUCATOR_ACCESS_CODE=

# Required: at least 32 characters. Generate with: openssl rand -hex 32
CLINICAL_SESSION_SECRET=

# Required for persistent student records: exactly 64 hexadecimal characters (32 bytes).
# Generate with: openssl rand -hex 32
CLINICAL_DATA_ENCRYPTION_KEY=
