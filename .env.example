# Configure secrets in your deployment environment; never commit real values.
GEMINI_API_KEY=""
APP_URL=""

# Tenant-aware credentials. The server determines BOTH tenant and role from the matching secret.
# Replace placeholders below with unique random secrets (each >=24 characters) for each school/program.
# JSON format example:
# {"school_a":{"clinician":"REPLACE_WITH_RANDOM_SECRET_A1","educator_readonly":"REPLACE_WITH_RANDOM_SECRET_A2"},"school_b":{"clinician":"REPLACE_WITH_RANDOM_SECRET_B1","educator_readonly":"REPLACE_WITH_RANDOM_SECRET_B2"}}
CLINICAL_TENANT_CREDENTIALS=""

# Required independent HMAC-SHA256 signing key (at least 32 characters).
CLINICAL_SESSION_SECRET=""

# Required 32-byte AES-256-GCM encryption key, exactly 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
CLINICAL_STORE_ENCRYPTION_KEY=""
