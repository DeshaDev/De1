# Supabase Database & Auth (Google OAuth)
# احصل على هذه القيم من لوحة تحكم Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Azure Speech pronunciation assessment: obtain these values from the Azure Speech resource. Do not prefix them with VITE_ or commit real credentials.
AZURE_SPEECH_KEY=YOUR_SPEECH_RESOURCE_KEY
AZURE_SPEECH_REGION=YOUR_SPEECH_RESOURCE_REGION

# Copy to .env for local development. Never commit real credentials.
# Optional Gemini API key; AI-backed functions may be unavailable without it.
GEMINI_API_KEY=

# JSON object: each school must have unique, high-entropy access codes for both roles.
# Each access code must be exactly 48 lowercase hex characters, generated independently.
# Run "openssl rand -hex 24" separately for every school/role; do not use passphrases or reuse values.
# {"school_a":{"schoolName":"اسم المدرسة أ","school_admin":"REPLACE_WITH_RANDOM_SECRET_A1","educator_readonly":"REPLACE_WITH_RANDOM_SECRET_A2"},"school_b":{"schoolName":"اسم المدرسة ب","school_admin":"REPLACE_WITH_RANDOM_SECRET_B1","educator_readonly":"REPLACE_WITH_RANDOM_SECRET_B2"}}
BASEERA_TENANT_CREDENTIALS=

# Independent HMAC-SHA256 signing secret (at least 32 characters); never reuse an access code.
BASEERA_SESSION_SECRET=

# AES-256-GCM storage key: exactly 64 hexadecimal characters (32 random bytes).
# Generate with: openssl rand -hex 32
BASEERA_STORE_ENCRYPTION_KEY=

# Dedicated platform-admin access code: 48 lowercase hex characters; generate with openssl rand -hex 24.
BASEERA_PLATFORM_ADMIN_CODE=

# Optional HTTPS-only alert destination. It receives school contact details and submitted notes; use a trusted, monitored endpoint only.
ADMIN_ALERT_WEBHOOK_URL=

# Use a persistent, access-restricted directory in deployment.
BASEERA_DATA_DIR=./.runtime-store

# Trusted proxy hops: integer 0..5. Keep 0 unless trusted proxies overwrite X-Forwarded-For.
TRUST_PROXY_HOPS=0

# HTTP port (local default).
PORT=3000
