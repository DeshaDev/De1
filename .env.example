# Configure secrets in your deployment environment; do not commit real values.
# Generate independent random secrets with: openssl rand -hex 32
GEMINI_API_KEY=""
APP_URL=""

# Required for clinical APIs. Use a unique random value of at least 24 characters.
CLINICAL_ACCESS_CODE=""

# Required HMAC-SHA256 session signing key (at least 32 characters).
