# Copy to .env for local development. Never commit real credentials.
# Optional Gemini API key; AI-backed functions may be unavailable without it.
GEMINI_API_KEY=

# JSON object: each school must have unique, high-entropy access codes for both roles.
# Each access code must be exactly 48 lowercase hex characters, generated independently.
# Run "openssl rand -hex 24" separately for every school/role; do not use passphrases or reuse values.
# {"school_a":{"schoolName":"اسم المدرسة أ","clinician":"REPLACE_WITH_RANDOM_SECRET_A1","educator_readonly":"REPLACE_WITH_RANDOM_SECRET_A2"},"school_b":{"schoolName":"اسم المدرسة ب","clinician":"REPLACE_WITH_RANDOM_SECRET_B1","educator_readonly":"REPLACE_WITH_RANDOM_SECRET_B2"}}
CLINICAL_TENANT_CREDENTIALS=

# Independent HMAC-SHA256 signing secret (at least 32 characters); never reuse an access code.
CLINICAL_SESSION_SECRET=

# AES-256-GCM storage key: exactly 64 hexadecimal characters (32 random bytes).
# Generate with: openssl rand -hex 32
CLINICAL_STORE_ENCRYPTION_KEY=

# Use a persistent, access-restricted directory in deployment.
CLINICAL_DATA_DIR=./.runtime-store

# Trusted proxy hops: integer 0..5. Keep 0 unless trusted proxies overwrite X-Forwarded-For.
TRUST_PROXY_HOPS=0

# HTTP port (local default).
PORT=3000
